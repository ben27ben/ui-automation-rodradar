  "type": "commonjs",
  "description": "",
  "devDependencies": {
    "@executeautomation/playwright-mcp-server": "^1.0.3",
    "@playwright/test": "^1.50.0",
    "@types/jquery": "^3.5.32",
    "@types/node": "^22.10.10",
    "allure-playwright": "^3.2.2",
    "playwright": "^1.51.1",
    "playwright-mcp": "^0.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
