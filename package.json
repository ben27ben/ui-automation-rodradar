{
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "jquery": "^3.7.1"
  },
  "name": "ui-automation-playwright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "tests": "playwright test",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report",
    "test:with-report": "playwright test && npm run report:generate && npm run report:open --headed",
    "testsDebug": "playwright test --debug",
    "tests:e2e": "playwright test --config=e2e.config.ts --project=Chromium"
  },
